const { S3Client, PutObjectCommand } = require("@aws-sdk/client-s3");
const { getSignedUrl } = require("@aws-sdk/s3-request-presigner");

const s3Client = new S3Client({ region: process.env.AWS_REGION });
const INPUT_BUCKET = process.env.INPUT_BUCKET_NAME;

exports.handler = async (event) => {
    try {
        const filename = event.queryStringParameters.filename;
        if (!filename) {
            return { statusCode: 400, body: "Nome do arquivo não fornecido." };
        }

        const command = new PutObjectCommand({
            Bucket: INPUT_BUCKET,
            Key: `uploads/${filename}`,
            ContentType: "image/*" 
        });

        // Gera uma URL válida por 5 minutos
        const presignedUrl = await getSignedUrl(s3Client, command, { expiresIn: 300 });

        return {
            statusCode: 200,
            headers: {
                "Access-Control-Allow-Origin": "*", // Necessário para o frontend conseguir acessar (CORS)
            },
            body: JSON.stringify({
                url: presignedUrl,
                fields: {} // A API v3 usa a própria URL para os campos
            })
        };
    } catch (error) {
        console.error(error);
        return { statusCode: 500, body: "Erro ao gerar URL assinada." };
    }
};
